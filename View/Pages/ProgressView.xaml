<Page x:Class="eSufara.View.Pages.ProgressView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:eSufara.View.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProgressView">

    <Grid Margin="32">
        <StackPanel Width="560" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Napredak"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="{StaticResource BrandBrush}"
                       TextAlignment="Center"
                       Margin="0,0,0,34"/>

            <TextBlock Text="Napredak u vežbama" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8"/>
            <Grid Height="34" Margin="0,0,0,26">
                <ProgressBar x:Name="ExercisesProgress"
                             Minimum="0"
                             Maximum="31"
                             Height="28"
                             VerticalAlignment="Center"/>
                <TextBlock x:Name="ProgressPercentExercises"
                           Text="65%"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Foreground="Black"
                           FontWeight="Bold"/>
            </Grid>

            <TextBlock Text="Napredak u lekcijama" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8"/>
            <Grid Height="34">
                <ProgressBar x:Name="LessonsProgress"
                             Minimum="0"
                             Maximum="32"
                             Height="28"
                             VerticalAlignment="Center"/>
                <TextBlock x:Name="ProgressPercentLessons"
                           Text="45%"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Foreground="Black"
                           FontWeight="Bold"/>
            </Grid>
        </StackPanel>
    </Grid>
</Page>
