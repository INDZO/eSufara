<Page x:Class="eSufara.View.Pages.SignUp"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:eSufara.View.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SignUp" Width="300" Height="340">

    <Grid Width="300" Height="340">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button x:Name="BackLI" Content="←" Width="46" Height="34" HorizontalAlignment="Left" Click="BackLI_Click"/>

        <StackPanel Grid.Row="1" Margin="0,10,0,0">
            <TextBlock Text="Korisničko ime" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="UsernameSU" Width="264" HorizontalAlignment="Left" TabIndex="0"/>
            <Label x:Name="GreskaPrazanUnos"
                   Content="Popunite sva obavezna polja."
                   Foreground="#B00020"
                   FontSize="12"
                   Padding="0"
                   Margin="0,4,0,0"
                   Visibility="Collapsed"/>
            <Label x:Name="GreskaUsernameDuzina"
                   Content="Korisničko ime mora imati 3-32 karaktera."
                   Foreground="#B00020"
                   FontSize="12"
                   Padding="0"
                   Margin="0,4,0,0"
                   Visibility="Collapsed"/>
            <Label x:Name="GreskaUsernameTaken"
                   Content="Korisničko ime je već zauzeto."
                   Foreground="#B00020"
                   FontSize="12"
                   Padding="0"
                   Margin="0,4,0,0"
                   Visibility="Collapsed"/>

            <TextBlock Text="Lozinka (minimum 8 karaktera)" FontWeight="SemiBold" Margin="0,10,0,4"/>
            <PasswordBox x:Name="PasswordSU" Width="264" HorizontalAlignment="Left" TabIndex="1"/>
            <Label x:Name="GreskaMaloKaraktera"
                   Content="Lozinka mora imati najmanje 8 karaktera."
                   Foreground="#B00020"
                   FontSize="12"
                   Padding="0"
                   Margin="0,4,0,0"
                   Visibility="Collapsed"/>

            <TextBlock Text="Potvrda lozinke" FontWeight="SemiBold" Margin="0,10,0,4"/>
            <PasswordBox x:Name="ConfirmSU" Width="264" HorizontalAlignment="Left" TabIndex="2"/>
            <Label x:Name="GreskaNepoklapanje"
                   Content="Lozinke se ne poklapaju."
                   Foreground="#B00020"
                   FontSize="12"
                   Padding="0"
                   Margin="0,4,0,0"
                   Visibility="Collapsed"/>
            <TextBlock x:Name="GreskaSistem"
                       Text="Registracija trenutno nije moguća. Proverite vezu sa bazom i pokušajte ponovo."
                       TextWrapping="Wrap"
                       Foreground="#B00020"
                       FontSize="12"
                       Margin="0,6,0,0"
                       Visibility="Collapsed"/>

            <DockPanel Margin="0,12,0,0">
                <Button x:Name="SlikaBTN" Content="Profilna slika" DockPanel.Dock="Right" Width="132" TabIndex="4" Click="SlikaBTN_Click"/>
                <Button x:Name="SignUpBTN" Content="Registruj se" Width="112" HorizontalAlignment="Left" TabIndex="3" IsDefault="True" Click="SignUpBTN_Click"/>
            </DockPanel>
        </StackPanel>

    </Grid>
</Page>
