<Page x:Name="ExercisePage" x:Class="eSufara.View.Pages.ExerciseView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="ExerciseView"
      Background="{StaticResource SurfaceBrush}">

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <Button Content="⟵ Nazad"
            Click="Back_Click"
            Width="118"
            Margin="0,0,14,0"
            DockPanel.Dock="Left"/>

            <TextBlock x:Name="txtTitle"
               Text="Vežba"
               FontSize="26"
               FontWeight="Bold"
               Foreground="{StaticResource BrandBrush}"
               VerticalAlignment="Center"
               DockPanel.Dock="Left"/>

            <StackPanel Orientation="Horizontal"
                DockPanel.Dock="Right"
                VerticalAlignment="Center"
                HorizontalAlignment="Right">
                <TextBlock Text="Pitanje: " FontWeight="SemiBold" Margin="0,0,6,0"/>
                <TextBlock x:Name="txtQuestionIndex" Text="1/3" Margin="0,0,16,0"/>
                <TextBlock Text="Rezultat: " FontWeight="SemiBold" Margin="0,0,6,0"/>
                <TextBlock x:Name="txtScore" Text="0"/>
            </StackPanel>
        </DockPanel>


        <Border Grid.Row="1" Height="1" Background="{StaticResource BorderBrushSoft}" />

        <Grid Grid.Row="2" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="btnReplay"
                    Content="▶ Reprodukuj ponovo"
                    Padding="12,8"
                    Click="btnReplay_Click"/>

            <ProgressBar x:Name="timerBar"
                         Grid.Column="2"
                         Height="22"
                         Minimum="0" Maximum="100"
                         Value="100"
                         VerticalAlignment="Center"
                         BorderThickness="1"/>
            
            <TextBlock x:Name="txtTimeLeft"
                       Grid.Column="4"
                       Text="10.0s"
                       VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="3" Height="1" Background="{StaticResource BorderBrushSoft}" />

        <UniformGrid Grid.Row="4" Columns="3" Margin="0,8,0,0">
            <Button x:Name="btnOpt1" Margin="8" Padding="14,12" FontSize="42" Click="Option_Click"/>
            <Button x:Name="btnOpt2" Margin="8" Padding="14,12" FontSize="42" Click="Option_Click"/>
            <Button x:Name="btnOpt3" Margin="8" Padding="14,12" FontSize="42" Click="Option_Click"/>
        </UniformGrid>

        <DockPanel Grid.Row="5" Margin="0,14,0,0">
            <CheckBox x:Name="chkCompleted"
                      Content="Označi vežbu kao završenu"
                      Checked="chkCompleted_Checked"
                      Unchecked="chkCompleted_Unchecked"
                      VerticalAlignment="Center"/>
            <Button x:Name="btnNext"
                    Content="Sledeće pitanje"
                    DockPanel.Dock="Right"
                    Padding="16,10"
                    Margin="10,0,0,0"
                    Click="btnNext_Click"/>
            <Button x:Name="btnFinish"
                    Content="Završi"
                    DockPanel.Dock="Right"
                    Padding="16,10"
                    Margin="10,0,0,0"
                    Click="btnFinish_Click"/>
        </DockPanel>
    </Grid>
</Page>
