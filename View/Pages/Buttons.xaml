<Page x:Class="eSufara.View.Pages.Buttons"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:eSufara.View.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Buttons" Width="300" Height="300">

    <Grid Width="300" Height="300" VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel VerticalAlignment="Center" Margin="20">
            <Button x:Name="LogInBTN" Content="Prijavi se" Height="42" Width="180" Click="LogInBTN_Click" Margin="0,0,0,14"/>
            <Button x:Name="SignUpBTN" Content="Registruj se" Height="42" Width="180" Click="SignUpBTN_Click"/>
        </StackPanel>
    </Grid>
</Page>
