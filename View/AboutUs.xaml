<Window x:Class="eSufara.View.AboutUs"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:eSufara.View"
        mc:Ignorable="d"
        Title="About eSufara" Height="430" Width="430" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock TextWrapping="Wrap"
                   Text="eSufara"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   FontSize="48"
                   Foreground="{StaticResource BrandBrush}"
                   FontFamily="Harlow Solid Italic"
                   Margin="0,0,0,22"/>
        <StackPanel Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Center" Width="344">


            <TextBlock Text="eSufara je edukativna aplikacija za učenje harfova. Namenjena je početnicima svih uzrasta."
                       TextAlignment="Center" 
                       TextWrapping="Wrap"
                       Margin="15,0,15,15"/>

            <TextBlock Text="Autor: Inas Hamzagić"
                       TextAlignment="Center"
                       Margin="0,0,0,10"/>

            <TextBlock Text="Predmet: Objektno orijentisano programiranje 2"
                       TextAlignment="Center"
                       Margin="0,0,0,10"/>

            <TextBlock Text="Kontakt: contact@example.invalid"
                       TextAlignment="Center"
                       Margin="0,0,0,10"/>


            <TextBlock Text ="GitHub: github.com/INDZO" 
                       TextAlignment="Center"/>

            <TextBlock Text="© 2025 eSufara. All rights reserved."
                       TextAlignment="Center"
                       FontSize="11"
                       Foreground="DarkGray"
                       Margin="0,20,0,5"
                       Opacity="0.8"/>
            
            <Button Content="OK"
                    Width="80"
                    Margin="0,20,0,0"
                    HorizontalAlignment="Center" Click="Button_Click"/>
        </StackPanel>
    </Grid>
</Window>
